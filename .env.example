# Copie para .env.local e ajuste. Nunca commite .env.local.

# URL base do motor oficial de regime regular, incluindo o context-path /api.
# Deixe vazio enquanto o motor não estiver rodando: o app mostrará "não configurado".
# Exemplo (perfil offline do upstream): http://localhost:8080/api
REGIME_REGULAR_ENGINE_URL=

# Timeout das chamadas ao motor, em milissegundos (500–120000). Padrão: 10000.
REGIME_REGULAR_ENGINE_TIMEOUT_MS=10000

# Motor oficial do Simples Nacional (calculadora-rtc-simples-nacional), opcional.
# Exemplo (perfil offline, porta padrão do upstream): http://localhost:8082/api
SIMPLES_NACIONAL_ENGINE_URL=
SIMPLES_NACIONAL_ENGINE_TIMEOUT_MS=10000

# Gerador oficial de DANFSe (calculadora-rtc-gerador-danfse), opcional. Sem /api:
# o app chama /api/danfse e /health/ready. A porta padrão do upstream (8080)
# conflita com o regime regular; rode com SERVER_PORT=8083.
DANFSE_ENGINE_URL=
DANFSE_ENGINE_TIMEOUT_MS=10000
# Versão que você está rodando (o gerador não tem endpoint de versão). Opcional.
DANFSE_ENGINE_VERSAO=
